# ───── 날씨 (선택) ─────
# 공공데이터포털 '기상청_단기예보 조회서비스' 에서 발급받은 키.
#   https://www.data.go.kr/data/15084084/openapi.do
# 넣으면 기상청 예보를 쓰고, 없으면 에버랜드 자체 날씨로 넘어간다.
DATA_GO_KR_KEY=

# ───── 첫 관리자 ─────
# 관리자 계정을 만들 때 물어보는 코드. 길게 아무거나 정해 넣으면 된다.
#   없으면 공개 배포에서 /setup 이 아예 잠긴다 — 주소를 아는 사람이
#   먼저 들어가 관리자가 되는 일을 막기 위해서다.
#   (로컬 개발에서는 비워 두어도 된다)
SETUP_CODE=

# ───── 모델 공급자 ─────
# ollama    = 내 컴퓨터에서 실행 (키 불필요, 비용 없음)
# anthropic = Anthropic API (기본)
AGENT_PROVIDER=ollama

# ── Ollama 를 쓸 때 ──
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_QUICK=qwen3:1.7b
OLLAMA_MODEL_DEFAULT=qwen3:4b

# Anthropic API 키 — 서버에서만 쓴다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
ANTHROPIC_API_KEY=sk-ant-...

# 워크스페이스에 묶이지 않은 조직 키를 쓸 때만 필요하다.
# (키가 워크스페이스 전용이면 비워 둔다. console.anthropic.com 의 Workspaces 에서 확인)
ANTHROPIC_WORKSPACE_ID=

# 에이전트가 쓰는 모델 (생략하면 아래 기본값)
AGENT_MODEL_QUICK=claude-haiku-4-5-20251001
AGENT_MODEL_DEFAULT=claude-sonnet-5

# ───── 저장소 ─────
# 비우면 메모리(서버 재시작하면 날아감). 파일 하나면 그대로 남는다.
#   로컬  file:./data/trip.db
#   배포  libsql://<db>.turso.io  + DATABASE_TOKEN
DATABASE_URL=file:./data/trip.db
DATABASE_TOKEN=
