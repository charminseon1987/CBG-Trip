# ───── 모델 공급자 ─────
# ollama    = 내 컴퓨터에서 실행 (키 불필요, 비용 없음)
# anthropic = Anthropic API (기본)
AGENT_PROVIDER=ollama

# ── Ollama 를 쓸 때 ──
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_QUICK=qwen3:8b
OLLAMA_MODEL_DEFAULT=qwen3:14b

# Anthropic API 키 — 서버에서만 쓴다. 절대 NEXT_PUBLIC_ 접두사를 붙이지 말 것.
ANTHROPIC_API_KEY=sk-ant-...

# 워크스페이스에 묶이지 않은 조직 키를 쓸 때만 필요하다.
# (키가 워크스페이스 전용이면 비워 둔다. console.anthropic.com 의 Workspaces 에서 확인)
ANTHROPIC_WORKSPACE_ID=

# 에이전트가 쓰는 모델 (생략하면 아래 기본값)
AGENT_MODEL_QUICK=claude-haiku-4-5-20251001
AGENT_MODEL_DEFAULT=claude-sonnet-5
